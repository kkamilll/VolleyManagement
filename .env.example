# ================================================================
# ANGELS ZTP - KONFIGURACJA ŚRODOWISKA
# ================================================================

# Połączenie z bazą danych MongoDB Atlas (opcjonalne w trybie lokalnym)
# Gdy zmienna MONGODB_URI jest pusta lub zakomentowana, aplikacja działa na pliku data/db.json.
# Gdy wkleisz tu link ze swojego klastra MongoDB Atlas, aplikacja automatycznie łączy się z chmurą
# i przy pierwszym uruchomieniu automatycznie importuje do niej wszystkie dane drużyny!
#
# Format z MongoDB Atlas:
# mongodb+srv://<USER>:<PASSWORD>@<CLUSTER-URL>/angels_ztp?retryWrites=true&w=majority
MONGODB_URI=

# Nazwa bazy danych w MongoDB Atlas (domyślnie: angels_ztp)
MONGODB_DB_NAME=angels_ztp

# Sekret do tokenów JWT sesji użytkowników
JWT_SECRET=angels_ztp_secret_key_2026_super_secure

# Port aplikacji (domyślnie 3000)
PORT=3000

